@page "/dashboard"
@rendermode InteractiveServer
@attribute [StreamRendering]
@attribute [Authorize]
@inject IRecetteService RecetteService
@inject NavigationManager NavManager

<PageTitle>Dashboard Recettes</PageTitle>

<div class="row mb-4 g-3">
    <div class="col-md-3">
        <KpiCard Title="Total Recettes"
                 Value="@TotalRecettes.ToString()"
                 BackgroundColorClass="bg-primary"
                 IconClass="bi-journal-richtext" />
    </div>
    <div class="col-md-3">
        <KpiCard Title="Total Ingrédients"
                 Value="@TotalIngredients.ToString()"
                 BackgroundColorClass="bg-success"
                 IconClass="bi-basket2-fill" />
    </div>
    <div class="col-md-3">
        <KpiCard Title="Catégories"
                 Value="@RepartitionCategorie.Count.ToString()"
                 BackgroundColorClass="bg-warning"
                 IconClass="bi-tags-fill" />
    </div>
    <div class="col-md-3">
        <KpiCard Title="Types de Cuisine"
                 Value="@RepartitionCuisine.Count.ToString()"
                 BackgroundColorClass="bg-info"
                 IconClass="bi-globe" />
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-bar-chart-fill text-primary"></i>
                    Calories Moyennes / Personne par Catégorie
                </h5>
            </div>
            <div class="card-body">
                <RadzenChart SeriesClick="@OnChartClick">
                    <RadzenColumnSeries Data="@StatsCategorie"
                                        CategoryProperty="Label"
                                        ValueProperty="Valeur"
                                        Title="kcal/pers">
                        <TooltipTemplate Context="d">
                            <b>@d.Label</b><br />@d.Valeur.ToString("F0") kcal/pers
                        </TooltipTemplate>
                    </RadzenColumnSeries>
                    <RadzenValueAxis Formatter="@(v => Math.Round((double)v, 0) + " kcal")" />
                    <RadzenLegend Visible="false" />
                </RadzenChart>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-pie-chart-fill text-success"></i>
                    Répartition par Catégorie
                </h5>
            </div>
            <div class="card-body">
                <RadzenChart>
                    <RadzenDonutSeries Data="@CountCategorie"
                                       CategoryProperty="Label"
                                       ValueProperty="Count">
                        <TitleTemplate>
                            <div class="rz-donut-content">
                                <div>Total</div>
                                <div>@TotalRecettes</div>
                            </div>
                        </TitleTemplate>
                    </RadzenDonutSeries>
                </RadzenChart>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-globe text-info"></i>
                    Calories Moyennes / Personne par Type de Cuisine
                </h5>
            </div>
            <div class="card-body">
                <RadzenChart>
                    <RadzenColumnSeries Data="@StatsCuisine"
                                        CategoryProperty="Label"
                                        ValueProperty="Valeur"
                                        Title="kcal/pers"
                                        Fill="#20c997">
                        <TooltipTemplate Context="d">
                            <b>@d.Label</b><br />@d.Valeur.ToString("F0") kcal/pers
                        </TooltipTemplate>
                    </RadzenColumnSeries>
                    <RadzenValueAxis Formatter="@(v => Math.Round((double)v, 0) + " kcal")" />
                    <RadzenLegend Visible="false" />
                </RadzenChart>
            </div>
        </div>
    </div>
</div>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="d-flex gap-2 mb-3">
            <a href="/edit-recette" class="btn btn-success">
                <i class="bi bi-plus-lg me-1"></i>Nouvelle Recette
            </a>
            <a href="/ingredients" class="btn btn-outline-secondary">
                <i class="bi bi-basket2 me-1"></i>Gérer les Ingrédients
            </a>
        </div>
    </Authorized>
</AuthorizeView>

<div class="row mb-3 align-items-end g-2">
    <div class="col-md-4">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text"
                   @bind="SearchText"
                   @bind:event="oninput"
                   class="form-control"
                   placeholder="Rechercher par titre..." />
        </div>
    </div>
    <div class="col-md-3">
        <select class="form-select" @onchange="OnFiltreCategorie">
            <option value="">-- Toutes catégories --</option>
            @foreach (var cat in Categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select" @onchange="OnFiltreCuisine">
            <option value="">-- Tous types --</option>
            @foreach (var type in TypesCuisine)
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>
    @if (!string.IsNullOrEmpty(FiltreCategorie) || !string.IsNullOrEmpty(FiltreCuisine) || !string.IsNullOrEmpty(SearchText))
    {
        <div class="col-md-2">
            <button class="btn btn-outline-secondary w-100" @onclick="ResetFiltres">
                <i class="bi bi-x-circle me-1"></i>Réinitialiser
            </button>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(FiltreCategorie))
{
    <div class="alert alert-info py-1 mb-2">
        Filtre actif : <strong>@FiltreCategorie</strong>
    </div>
}

<div class="mb-3">
    <button class="btn btn-outline-secondary btn-sm"
            @onclick="() => ShowAsCards = !ShowAsCards">
        <i class="bi bi-arrow-left-right me-1"></i>
        @(ShowAsCards ? "Vue Tableau" : "Vue Cartes")
    </button>
</div>


@if (RecettesFiltrees == null)
{
    <p>Chargement...</p>
}
else if (ShowAsCards)
{
    <!-- Vue Cartes -->
    <div class="row g-3">
        @foreach (var recette in RecettesFiltrees)
        {
            <div class="col-md-4">
                <RecetteCard Recette="recette"
                             CaloriesTotales="@CaloriesTotales.GetValueOrDefault(recette.Id, 0)"
                             CaloriesParPersonne="@CaloriesParPersonne.GetValueOrDefault(recette.Id, 0)"
                             OnDeleteClicked="SupprimerRecette" />
            </div>
        }
        @if (!RecettesFiltrees.Any())
        {
            <p class="text-muted text-center">Aucune recette trouvée.</p>
        }
    </div>
}
else
{

    <RecetteTable Recettes="RecettesFiltrees"
                  CaloriesTotales="CaloriesTotales"
                  CaloriesParPersonne="CaloriesParPersonne"
                  OnDeleteClicked="SupprimerRecette" />

    @if (!RecettesFiltrees.Any())
    {
        <p class="text-muted text-center">Aucune recette trouvée.</p>
    }
}

@code {
    private List<Recette>?          RecettesFiltrees;
    private int                     TotalRecettes;
    private int                     TotalIngredients;
    private Dictionary<string, int> RepartitionCategorie = new();
    private Dictionary<string, int> RepartitionCuisine   = new();
    private Dictionary<int, double> CaloriesTotales       = new();
    private Dictionary<int, double> CaloriesParPersonne   = new();
    private List<RecetteStat>       StatsCategorie        = new();
    private List<RecetteStat>       StatsCuisine          = new();
    private List<RecetteCountStat>  CountCategorie        = new();
    private bool                    ShowAsCards           = false;

    private string FiltreCategorie = "";
    private string FiltreCuisine   = "";
    private string _searchText     = "";

    private string SearchText
    {
        get => _searchText;
        set { _searchText = value; _ = ExecuteSearch(); }
    }

    private static readonly List<string> Categories   = new() { "Petit-déjeuner", "Déjeuner", "Dîner", "Dessert" };
    private static readonly List<string> TypesCuisine = new() { "Tunisienne", "Française", "Italienne", "Méditerranéenne", "Autre" };

    protected override async Task OnInitializedAsync()
    {
        await ChargerKpis();
        await ExecuteSearch();
    }

    private async Task ChargerKpis()
    {
        TotalRecettes        = await RecetteService.GetTotalRecettesAsync();
        TotalIngredients     = (await RecetteService.GetIngredientsAsync()).Count;
        RepartitionCategorie = await RecetteService.GetRepartitionParCategorieAsync();
        RepartitionCuisine   = await RecetteService.GetRepartitionParTypeCuisineAsync();
        StatsCategorie       = await RecetteService.GetCaloriesParCategorieAsync();
        CountCategorie       = await RecetteService.GetCountParCategorieAsync();
        StatsCuisine         = await RecetteService.GetCaloriesParTypeCuisineAsync();
    }

    private async Task ExecuteSearch()
    {
        RecettesFiltrees = await RecetteService.SearchRecettesAsync(
            string.IsNullOrEmpty(FiltreCategorie) ? null : FiltreCategorie,
            string.IsNullOrEmpty(FiltreCuisine)   ? null : FiltreCuisine,
            string.IsNullOrEmpty(_searchText)      ? null : _searchText);

        CaloriesTotales     = new();
        CaloriesParPersonne = new();
        foreach (var r in RecettesFiltrees)
        {
            CaloriesTotales[r.Id]     = await RecetteService.GetCaloriesTotalesRecetteAsync(r.Id);
            CaloriesParPersonne[r.Id] = await RecetteService.GetCaloriesParPersonneAsync(r.Id);
        }
        StateHasChanged();
    }

    private async Task OnChartClick(SeriesClickEventArgs args)
    {
        string clicked = args.Category.ToString() ?? "";
        FiltreCategorie = FiltreCategorie == clicked ? "" : clicked;
        await ExecuteSearch();
    }

    private async Task OnFiltreCategorie(ChangeEventArgs e)
    {
        FiltreCategorie = e.Value?.ToString() ?? "";
        await ExecuteSearch();
    }

    private async Task OnFiltreCuisine(ChangeEventArgs e)
    {
        FiltreCuisine = e.Value?.ToString() ?? "";
        await ExecuteSearch();
    }

    private async Task ResetFiltres()
    {
        FiltreCategorie = "";
        FiltreCuisine   = "";
        _searchText     = "";
        await ExecuteSearch();
    }

    private async Task SupprimerRecette(int id)
    {
        await RecetteService.DeleteRecetteAsync(id);
        await ChargerKpis();
        await ExecuteSearch();
    }
}