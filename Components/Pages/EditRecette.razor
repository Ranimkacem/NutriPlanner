@page "/edit-recette"
@page "/edit-recette/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject IRecetteService RecetteService
@inject NavigationManager NavigationManager

<PageTitle>@(Id.HasValue ? "Modifier la Recette" : "Nouvelle Recette")</PageTitle>
<h3>@(Id.HasValue ? "Modifier la Recette" : "Nouvelle Recette")</h3>

@if (_recette == null || _ingredients == null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <EditForm Model="_recette" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <!-- Titre -->
        <div class="mb-3">
            <label class="form-label">Titre :</label>
            <InputText @bind-Value="_recette.Titre" class="form-control" />
            <ValidationMessage For="@(() => _recette.Titre)" class="text-danger" />
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label class="form-label">Description :</label>
            <InputTextArea @bind-Value="_recette.Description" class="form-control" rows="3" />
        </div>

        <!-- Nombre de personnes -->
        <div class="mb-3">
            <label class="form-label">Nombre de personnes :</label>
            <InputNumber @bind-Value="_recette.NombrePersonnes" class="form-control" />
            <ValidationMessage For="@(() => _recette.NombrePersonnes)" class="text-danger" />
        </div>

        <!-- Catégorie -->
        <div class="mb-3">
            <label class="form-label">Catégorie :</label>
            <InputSelect @bind-Value="_recette.Categorie" class="form-select">
                <option value="Petit-déjeuner">Petit-déjeuner</option>
                <option value="Déjeuner">Déjeuner</option>
                <option value="Dîner">Dîner</option>
                <option value="Dessert">Dessert</option>
            </InputSelect>
        </div>

        <!-- Type de cuisine -->
        <div class="mb-3">
            <label class="form-label">Type de cuisine :</label>
            <InputSelect @bind-Value="_recette.TypeCuisine" class="form-select">
                <option value="Tunisienne">Tunisienne</option>
                <option value="Française">Française</option>
                <option value="Italienne">Italienne</option>
                <option value="Méditerranéenne">Méditerranéenne</option>
                <option value="Autre">Autre</option>
            </InputSelect>
        </div>

        <!-- ===== Section Ingrédients ===== -->
        <h5 class="mt-4">Ingrédients de la recette</h5>

        @if (_lignes.Count == 0)
        {
            <p class="text-muted">Aucun ingrédient ajouté pour l'instant.</p>
        }

        @for (int i = 0; i < _lignes.Count; i++)
        {
            var index = i; // capture pour le lambda
            <div class="row mb-2 align-items-center">
                <div class="col-md-5">
                    <select class="form-select"
                            value="@_lignes[index].IngredientId"
                            @onchange="e => ChangerIngredient(index, e)">
                        <option value="0">-- Choisir un ingrédient --</option>
                        @foreach (var ing in _ingredients)
                        {
                            <option value="@ing.Id">@ing.Nom (@ing.Unite)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="number" step="0.01" min="0.01"
                           class="form-control"
                           placeholder="Quantité"
                           value="@_lignes[index].Quantite"
                           @onchange="e => ChangerQuantite(index, e)" />
                </div>
                <div class="col-md-2 text-muted small">
                    @UniteIngredient(_lignes[index].IngredientId)
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            @onclick="() => SupprimerLigne(index)">
                        Retirer
                    </button>
                </div>
            </div>
        }

        <button type="button" class="btn btn-outline-secondary mb-3"
                @onclick="AjouterLigne">
            + Ajouter un ingrédient
        </button>

        <!-- Aperçu calories -->
        @if (_lignes.Any(l => l.IngredientId > 0 && l.Quantite > 0))
        {
            <div class="alert alert-info mt-2">
                <strong>Calories totales estimées :</strong> @CaloriesTotalesEstimees().ToString("F0") kcal
                @if (_recette.NombrePersonnes > 0)
                {
                    <span> — <strong>Par personne :</strong> @(CaloriesTotalesEstimees() / _recette.NombrePersonnes).ToString("F0") kcal</span>
                }
            </div>
        }

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="/dashboard" class="btn btn-secondary ms-2">Annuler</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Recette? _recette;
    private List<Ingredient>? _ingredients;

    // Lignes de travail (pas directement les RecetteIngredient EF)
    private List<LigneIngredient> _lignes = new();

    // DTO local pour éviter les conflits avec EF
    private class LigneIngredient
    {
        public int IngredientId { get; set; }
        public double Quantite  { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _ingredients = await RecetteService.GetIngredientsAsync();

        if (Id.HasValue)
        {
            _recette = await RecetteService.GetRecetteByIdAsync(Id.Value);
            if (_recette != null)
            {
                // Charger les lignes existantes
                _lignes = _recette.RecetteIngredients
                    .Select(ri => new LigneIngredient
                    {
                        IngredientId = ri.IngredientId,
                        Quantite     = ri.Quantite
                    })
                    .ToList();
            }
        }

        _recette ??= new Recette();
    }

    private void AjouterLigne()
        => _lignes.Add(new LigneIngredient());

    private void SupprimerLigne(int index)
        => _lignes.RemoveAt(index);

    private void ChangerIngredient(int index, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
            _lignes[index].IngredientId = id;
    }

    private void ChangerQuantite(int index, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(),
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture,
                out double q))
            _lignes[index].Quantite = q;
    }

    private string UniteIngredient(int ingredientId)
    {
        var ing = _ingredients?.FirstOrDefault(i => i.Id == ingredientId);
        return ing?.Unite ?? "";
    }

    private double CaloriesTotalesEstimees()
    {
        if (_ingredients == null) return 0;
        return _lignes
            .Where(l => l.IngredientId > 0 && l.Quantite > 0)
            .Sum(l =>
            {
                var ing = _ingredients.FirstOrDefault(i => i.Id == l.IngredientId);
                return ing == null ? 0 : l.Quantite * ing.CaloriesParUnite;
            });
    }

    private async Task HandleValidSubmit()
    {
        if (_recette == null) return;

        // Reconstruire les RecetteIngredients depuis les lignes
        _recette.RecetteIngredients = _lignes
            .Where(l => l.IngredientId > 0 && l.Quantite > 0)
            .Select(l => new RecetteIngredient
            {
                IngredientId = l.IngredientId,
                Quantite     = l.Quantite
            })
            .ToList();

        if (Id.HasValue)
            await RecetteService.UpdateRecetteAsync(_recette);
        else
            await RecetteService.AddRecetteAsync(_recette);

        NavigationManager.NavigateTo("/dashboard");
    }
}