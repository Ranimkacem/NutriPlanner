@page "/ingredients"
@attribute [Authorize]
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IRecetteService RecetteService
@inject NavigationManager NavManager

<PageTitle>Gestion des Ingrédients</PageTitle>
<h3>Ingrédients</h3>

<AuthorizeView Roles="Admin">
    <Authorized>
        <a href="/edit-ingredient" class="btn btn-success mb-3">
            <i class="bi bi-plus-lg me-1"></i>Nouvel Ingrédient
        </a>
    </Authorized>
</AuthorizeView>

@if (_ingredients == null)
{
    <p>Chargement...</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nom</th>
                <th>Calories / Unité</th>
                <th>Unité</th>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <th>Actions</th>
                    </Authorized>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var ing in _ingredients)
            {
                <tr>
                    <td>@ing.Nom</td>
                    <td>@ing.CaloriesParUnite kcal</td>
                    <td>@ing.Unite</td>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <td>
                                <a href="/edit-ingredient/@ing.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Éditer
                                </a>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => Supprimer(ing.Id)">
                                    <i class="bi bi-trash"></i> Supprimer
                                </button>
                            </td>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Ingredient>? _ingredients;

    protected override async Task OnInitializedAsync()
    {
        await Charger();
    }

    private async Task Charger()
    {
        _ingredients = await RecetteService.GetIngredientsAsync();
    }

    private async Task Supprimer(int id)
    {
        await RecetteService.DeleteIngredientAsync(id);
        await Charger();
    }
}
