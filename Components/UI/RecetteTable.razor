@using NutriPlanner.Models
@using Microsoft.AspNetCore.Components.Authorization

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Titre</th>
            <th>Catégorie</th>
            <th>Type Cuisine</th>
            <th>Personnes</th>
            <th>Cal. Totales</th>
            <th>Cal/Personne</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Recettes == null || !Recettes.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">
                    Aucune recette trouvée.
                </td>
            </tr>
        }
        else
        {
            @foreach (var recette in Recettes)
            {
                <tr>
                    <td>@recette.Titre</td>
                    <td><span class="badge bg-secondary">@recette.Categorie</span></td>
                    <td>@recette.TypeCuisine</td>
                    <td>@recette.NombrePersonnes</td>
                    <td>@CaloriesTotales.GetValueOrDefault(recette.Id, 0).ToString("F0") kcal</td>
                    <td>@CaloriesParPersonne.GetValueOrDefault(recette.Id, 0).ToString("F0") kcal</td>
                    <td>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <a href="/edit-recette/@recette.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Éditer
                                </a>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => TriggerDelete(recette.Id)">
                                    <i class="bi bi-trash"></i> Supprimer
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter] public List<Recette>            Recettes           { get; set; } = new();
    [Parameter] public Dictionary<int, double>  CaloriesTotales    { get; set; } = new();
    [Parameter] public Dictionary<int, double>  CaloriesParPersonne{ get; set; } = new();
    [Parameter] public EventCallback<int>        OnDeleteClicked    { get; set; }

    private async Task TriggerDelete(int id)
        => await OnDeleteClicked.InvokeAsync(id);
}